# .env.example — copy to .env and fill in real values
# NEVER commit .env — it is gitignored
# NEVER put real credentials here (this file IS committed)

# ---------------------------------------------------------------------------
# Postgres connection (used by backend and docker-compose db service)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/your_dbname

# docker-compose db service credentials (must match DATABASE_URL above)
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_dbname

# ---------------------------------------------------------------------------
# Backend application settings
# ---------------------------------------------------------------------------

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Application environment: development | production
ENV=development
