# ============================================================
# .gitignore — Fracture Recovery Dashboard
# ============================================================

# --------------- Secrets / local env (NEVER commit) --------
.env
backend/.env

# --------------- Python ─────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.so
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --------------- Node / Frontend ────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend/out/
*.tsbuildinfo

# --------------- Docker ─────────────────────────────────────
# (docker-compose.yml and Dockerfile are committed intentionally)

# --------------- OS ─────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# --------------- IDE ────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
